<routes>
    <!-- 
      STAGE 8 ROUTES (Asymmetric Traffic - REALISM UPGRADE)
      Goal: Stress Test RL with realistic, heavy traffic.
      
      Pattern:
      - North/South: VERY Heavy Traffic (1800 veh/hr)
      - East/West: Moderate Traffic (300 veh/hr)
      
      Changes from original:
      - Volume increased by ~50%
      - Added stochasticity (departPos, departSpeed, higher driver imperfection)
    -->

    <vType id="car" accel="2.0" decel="4.5" length="4.5" maxSpeed="13.9" minGap="2.5" sigma="0.5"/>
    
    <!-- Emergency Vehicle: White Color, Emergency UI Shape with Blinker -->
    <!-- Kept sigma=0.0 for predictable emergency behavior -->
    <vType id="emergency" vClass="emergency" guiShape="emergency" color="255,255,255" accel="3.0" decel="6.0" length="5.5" maxSpeed="25.0" minGap="2.0" sigma="0.0">
        <param key="has.bluelight.device" value="true"/>
    </vType>

    <!-- ROUTES (Same as Stage 7) -->
    <route id="N_S" edges="N_to_JN JN_to_J0 J0_to_JS JS_to_S"/>
    <route id="N_E" edges="N_to_JN JN_to_J0 J0_to_JE JE_to_E"/>
    <route id="N_W" edges="N_to_JN JN_to_J0 J0_to_JW JW_to_W"/>
    
    <route id="S_N" edges="S_to_JS JS_to_J0 J0_to_JN JN_to_N"/>
    <route id="S_W" edges="S_to_JS JS_to_J0 J0_to_JW JW_to_W"/>
    <route id="S_E" edges="S_to_JS JS_to_J0 J0_to_JE JE_to_E"/>
    
    <route id="E_W" edges="E_to_JE JE_to_J0 J0_to_JW JW_to_W"/>
    <route id="E_S" edges="E_to_JE JE_to_J0 J0_to_JS JS_to_S"/>
    <route id="E_N" edges="E_to_JE JE_to_J0 J0_to_JN JN_to_N"/>
    
    <route id="W_E" edges="W_to_JW JW_to_J0 J0_to_JE JE_to_E"/>
    <route id="W_N" edges="W_to_JW JW_to_J0 J0_to_JN JN_to_N"/>
    <route id="W_S" edges="W_to_JW JW_to_J0 J0_to_JS JS_to_S"/>

    <!-- ASYMMETRIC FLOWS -->
    
    <!-- HEAVY: North Inflow (Total ~1800) -->
    <flow id="f_NS" type="car" route="N_S" begin="0" end="20000" vehsPerHour="1200" departLane="best" departPos="random" departSpeed="random"/>
    <flow id="f_NE" type="car" route="N_E" begin="0" end="20000" vehsPerHour="300" departLane="best" departPos="random" departSpeed="random"/>
    <flow id="f_NW" type="car" route="N_W" begin="0" end="20000" vehsPerHour="300" departLane="best" departPos="random" departSpeed="random"/>
    
    <!-- HEAVY: South Inflow (Total ~1800) -->
    <flow id="f_SN" type="car" route="S_N" begin="0" end="20000" vehsPerHour="1200" departLane="best" departPos="random" departSpeed="random"/>
    <flow id="f_SW" type="car" route="S_W" begin="0" end="20000" vehsPerHour="300" departLane="best" departPos="random" departSpeed="random"/>
    <flow id="f_SE" type="car" route="S_E" begin="0" end="20000" vehsPerHour="300" departLane="best" departPos="random" departSpeed="random"/>
    
    <!-- LIGHT: East Inflow (Total ~300) -->
    <flow id="f_EW" type="car" route="E_W" begin="0" end="20000" vehsPerHour="150" departLane="best" departPos="random" departSpeed="random"/>
    <flow id="f_ES" type="car" route="E_S" begin="0" end="20000" vehsPerHour="75" departLane="best" departPos="random" departSpeed="random"/>
    <flow id="f_EN" type="car" route="E_N" begin="0" end="20000" vehsPerHour="75" departLane="best" departPos="random" departSpeed="random"/>
    
    <!-- LIGHT: West Inflow (Total ~300) -->
    <flow id="f_WE" type="car" route="W_E" begin="0" end="20000" vehsPerHour="150" departLane="best" departPos="random" departSpeed="random"/>
    <flow id="f_WN" type="car" route="W_N" begin="0" end="20000" vehsPerHour="75" departLane="best" departPos="random" departSpeed="random"/>
    <flow id="f_WS" type="car" route="W_S" begin="0" end="20000" vehsPerHour="75" departLane="best" departPos="random" departSpeed="random"/>

    <!-- EMERGENCY VEHICLES (Random injection to test Preemption) -->
    <!-- Approx 1 every 2 minutes (30/hr) from various directions -->
    <!-- Added randomness to departure position but max speed for urgency -->
    <flow id="f_EMG_N" type="emergency" route="N_S" begin="50" end="20000" vehsPerHour="15" departLane="best" departPos="random" departSpeed="max" color="255,255,255"/>
    <flow id="f_EMG_E" type="emergency" route="E_W" begin="100" end="20000" vehsPerHour="15" departLane="best" departPos="random" departSpeed="max" color="255,255,255"/>
    <flow id="f_EMG_S" type="emergency" route="S_N" begin="75" end="20000" vehsPerHour="15" departLane="best" departPos="random" departSpeed="max" color="255,255,255"/>
    <flow id="f_EMG_W" type="emergency" route="W_E" begin="125" end="20000" vehsPerHour="15" departLane="best" departPos="random" departSpeed="max" color="255,255,255"/>
    
</routes>
